# filamind-iot-proxy environment file template.
# Copy to .env and fill in. NEVER commit .env.

# ── Database ─────────────────────────────────────────────────────────
DB_USER=proxy
DB_PASSWORD=change-me-strong-random
DB_NAME=proxy

# ── Public URL the box phones home to ────────────────────────────────
# At deploy: https://iot-proxy.filamind.app  (or whatever your domain)
# Local dev: http://localhost:9100
PROXY_PUBLIC_URL=http://localhost:9100

# ── Pairing-code lifetime ────────────────────────────────────────────
# How long a pairing code stays valid before expiring (seconds).
# Default 7200 = 2 hours.
PAIRING_CODE_TTL_SECONDS=7200

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Phase 2 (added later) ────────────────────────────────────────────
# CLOUDFLARE_DNS_API_TOKEN=<scoped-zone-token>
# CERT_BASE_DOMAIN=box.filamind.app
# ACME_EMAIL=ops@filamind.app
# PROXY_MASTER_KEY=<base64-32-bytes>  # for cert private key encryption

# ── Phase 3 (added later) ────────────────────────────────────────────
# FRP_BIND_PORT=7000
# FRP_DASHBOARD_PORT=7001
# FRP_TOKEN=<random-shared-token>
# TUNNEL_BASE_DOMAIN=tunnel.filamind.app
