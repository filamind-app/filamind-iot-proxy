# filamind-iot-proxy environment file template.
# Copy to .env and fill in. NEVER commit .env.

# ── Database ─────────────────────────────────────────────────────────
DB_USER=proxy
DB_PASSWORD=change-me-strong-random
DB_NAME=proxy

# ── Public URL the box phones home to ────────────────────────────────
# At deploy: https://iot-proxy.filamind.app  (or whatever your domain)
# Local dev: http://localhost:9100
PROXY_PUBLIC_URL=http://localhost:9100

# ── Pairing-code lifetime ────────────────────────────────────────────
# How long a pairing code stays valid before expiring (seconds).
# Default 7200 = 2 hours.
PAIRING_CODE_TTL_SECONDS=7200

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Operator admin token ─────────────────────────────────────────────
# Long random string. /admin/* requires `Authorization: Bearer <this>`.
# If empty, every /admin/* request returns 503. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=

# ── Phase 2: ACME / Let's Encrypt via Cloudflare DNS-01 ──────────────
# All three of these must be set for /admin/boxes/{id}/issue_cert to
# work; with any empty, the endpoint returns 503 acme_not_configured.
#
# Token MUST be scoped to Zone:DNS:Edit on the wildcard zone only,
# never account-level (REQUIREMENTS.md §2). Rotate before TTL.
CLOUDFLARE_DNS_API_TOKEN=
# Wildcard zone the proxy mints `<short-id>.<this>` certs under.
CERT_BASE_DOMAIN=
# Contact email for the LE account; LE uses this for expiry warnings.
ACME_EMAIL=
# On-disk path inside the api container (mapped to ./data/acme on host).
ACME_STORAGE_PATH=/var/lib/proxy/acme
# Phase 7 hardening: envelope encryption for cert private keys.
# PROXY_MASTER_KEY=<base64-32-bytes>

# ── Phase 3: reverse tunnel (frp) ────────────────────────────────────
# Enable with: `docker compose --profile tunnel up -d`
# Box-side frpc uses these values too (see docs/REVERSE_TUNNEL.md).
#
# Shared auth token. Both server and EVERY box must hold this value.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
FRP_TOKEN=
# Public TCP port boxes connect to (the control channel).
FRP_BIND_PORT=7000
# vhost-HTTPS port — Caddy fronts this on 443 in Phase 7. For now the
# port is bound to 127.0.0.1 only.
FRP_VHOST_HTTPS_PORT=7443
# Dashboard at http://localhost:7500/ — only reachable over SSH tunnel.
FRP_DASHBOARD_PORT=7500
FRP_DASHBOARD_USER=admin
FRP_DASHBOARD_PASSWORD=
